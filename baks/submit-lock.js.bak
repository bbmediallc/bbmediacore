jQuery(document).ready(function ($) {
    console.log('jQuery is loaded and ready.');

    $('form').on('submit', function (e) {
        console.log('Form submit event triggered.');

        // Change submit button text instead of disabling
        var submitButton = $(this).find('input[type="submit"]');
        if (submitButton.length) {
            console.log('Changing submit button text...');
            submitButton.val('Submitting...');
        }

        // Optionally add a loading indicator
        if (!$(this).find('.loading-indicator').length) {
            console.log('Adding loading indicator...');
            $(this).append('<div class="loading-indicator">Submitting your ticket...</div>');
        }

        // Allow the form to proceed
        return true;
    });
});
